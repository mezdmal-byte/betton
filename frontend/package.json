{
  "name": "betton-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "dev:theme-pilot": "vite --config vite.pilot.config.ts",
    "build:theme-pilot": "tsc -p tsconfig.pilot.json && vite build --config vite.pilot.config.ts",
    "preview:theme-pilot": "vite preview --config vite.pilot.config.ts",
    "check:theme-pilot": "node scripts/check-theme-pilot.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.103.1",
    "lucide-react": "^0.525.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/react": "^8.6.14",
    "@storybook/react-vite": "^8.6.14",
    "@types/node": "^24.13.3",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^4.7.0",
    "storybook": "^8.6.14",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^5.0.1"
  }
}
