DATABASE_URL=sqlite:///./betton.db
BOT_TOKEN=
MINI_APP_URL=https://betton-630y.onrender.com
PUBLIC_BASE_URL=https://betton-630y.onrender.com
TIP_CAP=0.01
ADMIN_TELEGRAM_ID=
TELEGRAM_BOT_USERNAME=
ADMIN_TELEGRAM_USERNAMES=
PANDASCORE_TOKEN=
BETTON_PREVIEW_SEED=false

# Generate independently with secrets.token_urlsafe(32); keep only in secret storage.
TELEGRAM_WEBHOOK_SECRET=
# Temporary overlap during rotation; remove after Telegram switches.
TELEGRAM_WEBHOOK_PREVIOUS_SECRET=
# Only for authenticated forwarding to an explicitly configured upstream.
TELEGRAM_WEBHOOK_PROXY_SECRET=

# Stable Telegram IDs only; legacy ADMIN_TELEGRAM_ID remains supported.
ADMIN_TELEGRAM_IDS=
# Explicit revocation overrides both legacy ID and the allowlist; does not change treasury ID.
ADMIN_TELEGRAM_REVOKED_IDS=

# Secure default: reject old /buy clients before any debit. Temporary transition only.
ALLOW_UNKEYED_LEGACY_BUY=false
